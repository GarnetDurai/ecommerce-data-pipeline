# ==============================================================================
# E-Commerce Real-Time Data Pipeline - Environment Configuration Template
# Copy this file to .env and configure your own settings:
#   cp .env.example .env
#
# DO NOT store real AWS secret keys or sensitive tokens in this file or repo.
# ==============================================================================

# AWS S3 Storage Configuration (Configure your own bucket)
S3_BUCKET=your-bucket-name
S3_PREFIX=ecommerce/processed_v2
AWS_REGION=your-region

# Optional Kafka Broker Settings (defaults to localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce-orders

# Optional Local Checkpoint and Storage Paths
CHECKPOINT_DIR=data/checkpoints/orders_v2
PROCESSED_DATA_PATH=data/processed
